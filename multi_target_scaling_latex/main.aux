\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Performance of the proposed TSCP method and alternative conformal prediction approaches on real datasets. Results are averaged over $200$ random splits of the data into training/calibration/and test subsets, with one standard deviation reported in parentheses. The target coverage level is $0.9$. Coverage values below the target are highlighted in \textcolor {red}{red}, and the smallest volume among methods achieving valid coverage is highlighted in \textbf  {bold}.}}{23}{table.caption.5}\protected@file@percent }
\newlabel{tab:real}{{1}{23}{Performance of the proposed TSCP method and alternative conformal prediction approaches on real datasets. Results are averaged over $200$ random splits of the data into training/calibration/and test subsets, with one standard deviation reported in parentheses. The target coverage level is $0.9$. Coverage values below the target are highlighted in \textcolor {red}{red}, and the smallest volume among methods achieving valid coverage is highlighted in \textbf {bold}}{table.caption.5}{}}
