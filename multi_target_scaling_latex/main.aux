\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Illustration of the construction of transductively standardized conformal prediction sets using the method outlined in~\eqref  {eq:lwc-joint-union}, with the data-driven partition $\mathcal  {P}_{n,d}$ of the outcome space defined in~\eqref  {eq:rectangle-explicit}, in a toy example with a two-dimensional outcome variable. The gray grid lines indicate the partition $\mathcal  {P}_{n,d}$ in the residual space, as determined by the order statistics $E^{(k)}_j$ of the calibration residuals. The shaded rectangles represent local prediction sets $\hat  {C}^\mathrm  {lwc}(\mathbf  {X}^{n+1}; \mathcal  {R})$ corresponding to different hypothesized rectangles $\mathcal  {R} \in \mathcal  {P}_{n,d}$. The solid rectangle shows the projection, in residual space, of their rectangular enclosure defined in~\eqref  {eq:lwc-joint-union}, which constitutes our final prediction set. For comparison, the larger dashed rectangle shows the corresponding projection of the more conservative prediction set $\hat  {C}^\mathrm  {gwc}(\mathbf  {X}^{n+1})$ from Section~\ref {sec:method-gwc}.}}{15}{figure.caption.2}\protected@file@percent }
\newlabel{fig:global-to-local}{{2}{15}{Illustration of the construction of transductively standardized conformal prediction sets using the method outlined in~\eqref {eq:lwc-joint-union}, with the data-driven partition $\mathcal {P}_{n,d}$ of the outcome space defined in~\eqref {eq:rectangle-explicit}, in a toy example with a two-dimensional outcome variable. The gray grid lines indicate the partition $\mathcal {P}_{n,d}$ in the residual space, as determined by the order statistics $E^{(k)}_j$ of the calibration residuals. The shaded rectangles represent local prediction sets $\hat {C}^\mathrm {lwc}(\mathbf {X}^{n+1}; \mathcal {R})$ corresponding to different hypothesized rectangles $\mathcal {R} \in \mathcal {P}_{n,d}$. The solid rectangle shows the projection, in residual space, of their rectangular enclosure defined in~\eqref {eq:lwc-joint-union}, which constitutes our final prediction set. For comparison, the larger dashed rectangle shows the corresponding projection of the more conservative prediction set $\hat {C}^\mathrm {gwc}(\mathbf {X}^{n+1})$ from Section~\ref {sec:method-gwc}}{figure.caption.2}{}}
\newlabel{eq:lwc-residual-transformation}{{22}{15}{}{equation.22}{}}
\newlabel{eq:lwc-transformation-bound}{{23}{15}{}{equation.23}{}}
\newlabel{lem:lwc-rescaling}{{7}{15}{}{lemma.7}{}}
