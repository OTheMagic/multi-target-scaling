\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, as in Figure~\ref  {fig:gaussian-heter}. All results are averaged over $200$ trials with their one standard deviation reported in parenthesis. The target coverage level is $0.9$. Coverage below this target is highlighted in \leavevmode {\color  {red}red}. For volume, lower is better. Smallest volume size (among those with valid theoretical coverage) is highlighted in \textbf  {bold}. TSCP yields the tightest volume while maintaining valid coverage.\relax }}{50}{table.caption.19}\protected@file@percent }
\newlabel{tab:gaussian-heter}{{S4}{50}{Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, as in Figure~\ref {fig:gaussian-heter}. All results are averaged over $200$ trials with their one standard deviation reported in parenthesis. The target coverage level is $0.9$. Coverage below this target is highlighted in \textcolor {red}{red}. For volume, lower is better. Smallest volume size (among those with valid theoretical coverage) is highlighted in \textbf {bold}. TSCP yields the tightest volume while maintaining valid coverage.\relax }{table.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, as in Figure~\ref  {fig:gaussian-homo}. Other details are as in Table~\ref  {tab:gaussian-heter}. In this case, Unscaled Max yields the tightest volume while maintaining valid coverage, while TSCP remains a competitive second. \relax }}{51}{table.caption.21}\protected@file@percent }
\newlabel{tab:gaussian-homo}{{S5}{51}{Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, as in Figure~\ref {fig:gaussian-homo}. Other details are as in Table~\ref {tab:gaussian-heter}. In this case, Unscaled Max yields the tightest volume while maintaining valid coverage, while TSCP remains a competitive second. \relax }{table.caption.21}{}}
