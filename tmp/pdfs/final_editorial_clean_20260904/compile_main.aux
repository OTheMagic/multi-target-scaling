\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Absolute-residual experiment with $d=10$, independent Gaussian noise, and heterogeneous scales $(10,9,\ldots  ,1)$. Panels report mean joint coverage and residual-space volume over 200 repetitions. The dashed line marks the target coverage $0.9$. TSCP attains near-nominal coverage with smaller residual-space volumes than Point CHR and Unscaled Max.\relax }}{21}{figure.caption.3}\protected@file@percent }
\newlabel{fig:gaussian-heter}{{3}{21}{Absolute-residual experiment with $d=10$, independent Gaussian noise, and heterogeneous scales $(10,9,\ldots ,1)$. Panels report mean joint coverage and residual-space volume over 200 repetitions. The dashed line marks the target coverage $0.9$. TSCP attains near-nominal coverage with smaller residual-space volumes than Point CHR and Unscaled Max.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Absolute-residual experiment with $d=10$, independent Gaussian noise, and unit scale in every coordinate. Panels report mean joint coverage and residual-space volume over 200 repetitions. The dashed line marks the target coverage $0.9$. Among methods with near-nominal coverage, Unscaled Max has the smallest residual-space volume, while TSCP remains competitive.\relax }}{21}{figure.caption.4}\protected@file@percent }
\newlabel{fig:gaussian-homo}{{4}{21}{Absolute-residual experiment with $d=10$, independent Gaussian noise, and unit scale in every coordinate. Panels report mean joint coverage and residual-space volume over 200 repetitions. The dashed line marks the target coverage $0.9$. Among methods with near-nominal coverage, Unscaled Max has the smallest residual-space volume, while TSCP remains competitive.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Absolute-residual experiment with $d=10$, heterogeneous Gaussian scales $(10,9,\ldots  ,1)$, and equicorrelation $\rho =0.6$. Panels report mean joint coverage, residual-space volume, and construction time over 200 repetitions. The dashed line marks the target coverage $0.9$. Runtime excludes model fitting and residual computation.\relax }}{22}{figure.caption.5}\protected@file@percent }
\newlabel{fig:body-abs-overview}{{5}{22}{Absolute-residual experiment with $d=10$, heterogeneous Gaussian scales $(10,9,\ldots ,1)$, and equicorrelation $\rho =0.6$. Panels report mean joint coverage, residual-space volume, and construction time over 200 repetitions. The dashed line marks the target coverage $0.9$. Runtime excludes model fitting and residual computation.\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Coordinate-wise mean full interval lengths for the absolute-residual experiment with $d=10$, $n=100$, heterogeneous Gaussian scales $(10,9,\ldots  ,1)$, and equicorrelation $\rho =0.6$. Residual-space half-widths are multiplied by two to report full outcome intervals. Results average 200 independent repetitions. Unscaled Max assigns the same length to every coordinate, while others adapt to the coordinate scales.\relax }}{22}{figure.caption.6}\protected@file@percent }
\newlabel{fig:body-abs-coordinate-bars}{{6}{22}{Coordinate-wise mean full interval lengths for the absolute-residual experiment with $d=10$, $n=100$, heterogeneous Gaussian scales $(10,9,\ldots ,1)$, and equicorrelation $\rho =0.6$. Residual-space half-widths are multiplied by two to report full outcome intervals. Results average 200 independent repetitions. Unscaled Max assigns the same length to every coordinate, while others adapt to the coordinate scales.\relax }{figure.caption.6}{}}
