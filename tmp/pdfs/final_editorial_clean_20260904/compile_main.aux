\newlabel{fig:body-real-runtime}{{10}{27}{Average wall-clock time for conformal region construction on the six real datasets. The vertical axis is logarithmic and reports milliseconds. All methods use the same fitted regression model in each split; model fitting and residual computation are excluded.\relax }{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Illustration of rectangular conformal prediction sets for two test points from the \emph  {energy} dataset. Volumes are computed in residual space. Intervals that fail to cover the corresponding true outcomes are highlighted in \leavevmode {\color  {red}red}; the shortest interval containing each true outcome is highlighted in \textbf  {bold}. This example is illustrative: conformal coverage guarantees hold on average, not for individual test points.\relax }}{27}{table.caption.12}\protected@file@percent }
\newlabel{tab:toy}{{2}{27}{Illustration of rectangular conformal prediction sets for two test points from the \emph {energy} dataset. Volumes are computed in residual space. Intervals that fail to cover the corresponding true outcomes are highlighted in \textcolor {red}{red}; the shortest interval containing each true outcome is highlighted in \textbf {bold}. This example is illustrative: conformal coverage guarantees hold on average, not for individual test points.\relax }{table.caption.12}{}}
