\@writefile{toc}{\contentsline {subsubsection}{\numberline {C.1.1}Gaussian Noise (heterogeneous)}{42}{subsubsection.C.1.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, as in Figure~\ref {fig:gaussian-heter}. All results are averaged over $200$ trials with their one standard deviation reported in parenthesis. The target coverage level is $0.9$. Coverage below this target is highlighted in \textcolor {red}{red}. For volume, lower is better. Smallest volume size (among those with valid theoretical coverage) is highlighted in \textbf  {bold}. TSCP yields the tightest volume while maintaining valid coverage.}}{42}{table.caption.9}\protected@file@percent }
\newlabel{tab:gaussian-heter}{{S3}{42}{Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, as in Figure~\ref {fig:gaussian-heter}. All results are averaged over $200$ trials with their one standard deviation reported in parenthesis. The target coverage level is $0.9$. Coverage below this target is highlighted in \textcolor {red}{red}. For volume, lower is better. Smallest volume size (among those with valid theoretical coverage) is highlighted in \textbf {bold}. TSCP yields the tightest volume while maintaining valid coverage}{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {C.1.2}Gaussian Noise (homogeneous)}{43}{subsubsection.C.1.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, as in Figure~\ref {fig:gaussian-homo}. Other details are as in Table~\ref {tab:gaussian-heter}. In this case, Unscaled Max yields the tightest volume while maintaining valid coverage, while TSCP remains a competitive second. }}{43}{table.caption.10}\protected@file@percent }
\newlabel{tab:gaussian-homo}{{S4}{43}{Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, as in Figure~\ref {fig:gaussian-homo}. Other details are as in Table~\ref {tab:gaussian-heter}. In this case, Unscaled Max yields the tightest volume while maintaining valid coverage, while TSCP remains a competitive second}{table.caption.10}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {C.1.3}Laplace Noise}{44}{subsubsection.C.1.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, and noise following a \emph  {Laplace} distribution; i.e., $\epsilon _j \sim \mathrm  {Laplace}(10-j+1)$ for all $j \in [10]$. Other details are as in Table~\ref {tab:gaussian-heter}.}}{44}{table.caption.11}\protected@file@percent }
\newlabel{tab:laplace}{{S5}{44}{Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, and noise following a \emph {Laplace} distribution; i.e., $\epsilon _j \sim \mathrm {Laplace}(10-j+1)$ for all $j \in [10]$. Other details are as in Table~\ref {tab:gaussian-heter}}{table.caption.11}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {C.1.4}Mixture Noise}{45}{subsubsection.C.1.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, and noise following a \emph  {Mixture} distribution; i.e., $\epsilon _j \sim \frac  {1}{2}\mathrm  {Laplace}(10-j+1)+\frac  {1}{2}\mathcal  {N}(0, (10-j+1)^2)$ for all $j \in [10]$. Other details are as in Table~\ref {tab:gaussian-heter}.}}{45}{table.caption.12}\protected@file@percent }
\newlabel{tab:mixed}{{S6}{45}{Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, and noise following a \emph {Mixture} distribution; i.e., $\epsilon _j \sim \frac {1}{2}\mathrm {Laplace}(10-j+1)+\frac {1}{2}\mathcal {N}(0, (10-j+1)^2)$ for all $j \in [10]$. Other details are as in Table~\ref {tab:gaussian-heter}}{table.caption.12}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {C.1.5}Gamma Noise}{46}{subsubsection.C.1.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, and noise following a \emph  {Gamma} distribution; i.e., $\epsilon _j \sim \mathrm  {Gamma}(1, 10-j+1)$ for all $j \in [10]$. Other details are as in Table~\ref {tab:gaussian-heter}.}}{46}{table.caption.13}\protected@file@percent }
\newlabel{tab:gamma}{{S7}{46}{Performance of the proposed TSCP method and alternative conformal prediction approaches on simulated data with $d=10$ outcome variables, and noise following a \emph {Gamma} distribution; i.e., $\epsilon _j \sim \mathrm {Gamma}(1, 10-j+1)$ for all $j \in [10]$. Other details are as in Table~\ref {tab:gaussian-heter}}{table.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {C.2}Comparison of Alternative Implementations of TSCP}{47}{subsection.C.2}\protected@file@percent }
\newlabel{app:ours_simulation}{{C.2}{47}{Software Availability}{subsection.C.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Performance of TSCP and alternative approaches on simulated data with $d=2$ targets and heterogeneous Laplace noise. The target coverage level is $90\%$. Results are averaged over $200$ trials. All methods achieve near-nominal coverage and approximate \emph  {Pop.~Oracle} as the calibration sample size increases. TSCP tracks TSCP-LWC closely, with an almost indistinguishable average volume, highlighting the tightness of its rectangular enclosure.}}{47}{figure.caption.14}\protected@file@percent }
\newlabel{fig:approximation1}{{S1}{47}{Performance of TSCP and alternative approaches on simulated data with $d=2$ targets and heterogeneous Laplace noise. The target coverage level is $90\%$. Results are averaged over $200$ trials. All methods achieve near-nominal coverage and approximate \emph {Pop.~Oracle} as the calibration sample size increases. TSCP tracks TSCP-LWC closely, with an almost indistinguishable average volume, highlighting the tightness of its rectangular enclosure}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Performance of TSCP and alternative approaches on simulated data with $d=10$ targets. Other details are as in Figure~\ref {fig:approximation1}. TSCP-LWC is omitted from this figure due to its prohibitive cost with even moderately high-dimensional outcomes.}}{48}{figure.caption.15}\protected@file@percent }
\newlabel{fig:approximation2}{{S2}{48}{Performance of TSCP and alternative approaches on simulated data with $d=10$ targets. Other details are as in Figure~\ref {fig:approximation1}. TSCP-LWC is omitted from this figure due to its prohibitive cost with even moderately high-dimensional outcomes}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Performance of TSCP and alternative approaches on simulated data with fixed sample size $|\mathcal  {D}_{\mathrm  {cal}}|=30$, as a function of the number of output dimensions $d$. Other details are as in Figure~\ref {fig:approximation1}. These results are averaged over $30$ independent repetitions. The runtime results are presented in seconds on a $\log _{10}$ scale. The runtime of all methods except TSCP-LWC scales well with number of dimensions. TSCP-LWC is only applied when $d \in \{2,3,4\}$ due to the exponential growth of its runtime. }}{48}{figure.caption.16}\protected@file@percent }
\newlabel{fig:runtime}{{S3}{48}{Performance of TSCP and alternative approaches on simulated data with fixed sample size $|\mathcal {D}_{\mathrm {cal}}|=30$, as a function of the number of output dimensions $d$. Other details are as in Figure~\ref {fig:approximation1}. These results are averaged over $30$ independent repetitions. The runtime results are presented in seconds on a $\log _{10}$ scale. The runtime of all methods except TSCP-LWC scales well with number of dimensions. TSCP-LWC is only applied when $d \in \{2,3,4\}$ due to the exponential growth of its runtime}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {C.3}Robustness to Heavy-Tailed Data}{49}{subsection.C.3}\protected@file@percent }
\newlabel{app:hevy_tailed_simulation}{{C.3}{49}{Software Availability}{subsection.C.3}{}}
\newlabel{fig:t-n30-10d}{{S4a}{49}{Small sample, $|\mathcal {D}_{\mathrm {cal}}|=30$. Output dimensions $d=10$}{figure.caption.17}{}}
\newlabel{sub@fig:t-n30-10d}{{a}{49}{Small sample, $|\mathcal {D}_{\mathrm {cal}}|=30$. Output dimensions $d=10$}{figure.caption.17}{}}
\newlabel{fig:t-n500-10d}{{S4b}{49}{Large sample, $|\mathcal {D}_{\mathrm {cal}}|=500$. Output dimensions $d=10$}{figure.caption.17}{}}
\newlabel{sub@fig:t-n500-10d}{{b}{49}{Large sample, $|\mathcal {D}_{\mathrm {cal}}|=500$. Output dimensions $d=10$}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Performance of the proposed TSCP method and other approaches on simulated data with noise following a Student's-$t$ distribution with varying degrees of freedom, using small (a) and large (b) sample sizes. The target coverage level is 0.9. All methods except \emph  {Emp.~Copula} have near-nominal coverage in all settings. TSCP maintains valid marginal coverage even on very heavy-tailed data. In the small sample setting, Point CHR suffers more in terms of prediction set size due to its inefficient use of calibration data, although it can outperform TSCP in large samples.}}{49}{figure.caption.17}\protected@file@percent }
\newlabel{fig:t}{{S4}{49}{Performance of the proposed TSCP method and other approaches on simulated data with noise following a Student's-$t$ distribution with varying degrees of freedom, using small (a) and large (b) sample sizes. The target coverage level is 0.9. All methods except \emph {Emp.~Copula} have near-nominal coverage in all settings. TSCP maintains valid marginal coverage even on very heavy-tailed data. In the small sample setting, Point CHR suffers more in terms of prediction set size due to its inefficient use of calibration data, although it can outperform TSCP in large samples}{figure.caption.17}{}}
